<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0-desktop</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Display name -->
        <ApplicationTitle>SpaceInvaders</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.companyname.SpaceInvaders</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <!-- Package Publisher -->
        <ApplicationPublisher>O=SpaceInvaders</ApplicationPublisher>
        <!-- Package Description -->
        <Description>SpaceInvaders powered by Uno Platform.</Description>

        <!--
          UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
          https://aka.platform.uno/singleproject-features
        -->
        <UnoFeatures>
            Mvvm;
            SkiaRenderer;
        </UnoFeatures>
    </PropertyGroup>
    <ItemGroup>
      <UnoSplashScreen Remove="Assets\Splash\splash_screen.svg" />
    </ItemGroup>
    <ItemGroup>
      <None Remove="Sounds\barrier_hit.mp3" />
      <None Remove="Sounds\invader_hit.mp3" />
      <None Remove="Sounds\shoot.mp3" />
      <None Remove="Sounds\start.mp3" />
      <None Remove="Sounds\win.mp3" />
      <None Remove="Sounds\shoot.wav" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="NAudio" />
    </ItemGroup>
    <ItemGroup>
      <Content Include="Sounds\explosion.wav" />
      <Content Include="Sounds\shoot.wav" />
      <None Remove="Sounds\spaceinvaders1.wav" />
      <Content Include="Sounds\spaceinvaders1.wav">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Sounds\explosion.wav" />
      <None Remove="Sounds\invaderkilled.wav" />
      <Content Include="Sounds\invaderkilled.wav">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="Fonts\pixel-invaders.ttf" />
    </ItemGroup>

</Project>
